{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh tooling/harness/sdd-session-context.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh tooling/harness/sdd-edit-check.sh"
          }
        ],
        "matcher": "Write|Edit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh tooling/harness/sdd-deploy-precheck.sh"
          },
          {
            "type": "command",
            "command": "sh tooling/harness/sdd-diagnosis-check.sh"
          },
          {
            "type": "command",
            "command": "sh tooling/harness/sdd-risky-action-check.sh"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh tooling/harness/sdd-deploy-check.sh"
          }
        ],
        "matcher": "Bash"
      }
    ]
  }
}
