#!/bin/sh
# git pre-commit — 방법론 게이트 hard 차단.
# sdd-init가 scripts/sdd-pre-commit.sh로 설치 + .git/hooks/pre-commit(및 pre-merge-commit)이 이를 호출.
#
# 경로 필터 없음(감사 P3): 과거 src/|lib/|app/|tests/ 하드코딩 필터는 Go(cmd/·pkg/)·Python 패키지
# 등 비-JS 레이아웃에서 게이트를 한 번도 발동시키지 않았다 — config scanDirs(언어 무관 어댑터)와
# 어긋난 강제 지점. 게이트는 레포 상태 전역 스캔이라(스테이징 내용 비의존) 매 커밋 실행이 옳고 빠르다.
set -e
DIR=$(git rev-parse --show-toplevel) || { echo "sdd pre-commit: git 저장소 아님" >&2; exit 1; }
cd "$DIR"
if [ ! -f scripts/check-fr-coverage.mjs ] || [ ! -f scripts/check-ownership.mjs ]; then
  echo "sdd pre-commit: 게이트가 scripts/에 없음 — sdd-init 재실행 필요" >&2
  exit 1
fi
node scripts/check-fr-coverage.mjs   # PREFIX 화이트리스트·사유·번호 무결성·조용한누락(exit 1)
# check-ownership: --strict 없이 exit 1인 것 = 중복 소유(dedup)·관계 대상 실재(SPEC-017)·
# entityRegistry·capabilityVerbs 사유·정책 enum/카테고리 위반 + 귀속(SPEC-024)·스키마
# 백킹(SPEC-026)이 hard일 때, 그리고 capabilityVerbPolicy가 hard일 때의 미등록 verb.
# 나머지 키 형식(Capability 점표기·Surface 형식)과 Ownership 블록 부재는 ⚠ warn이고
# exit 0이다 — 이 훅은 --strict를 붙이지 않는다(그 형식들을 차단하려면 --strict를 명시하라).
node scripts/check-ownership.mjs
# check-deploy-debt: outOfBandDeployPolicy=hard일 때만 발화한다(그 외엔 즉시 exit 0, 파일 IO 1회).
# hard가 advisory와 다른 유일한 지점 — 미기록 배포를 적재해 두고 여기서 커밋을 막는다.
# 게이트가 없는 구버전 배선에서도 커밋이 죽지 않도록 존재를 확인하고 부른다.
if [ -f scripts/check-deploy-debt.mjs ]; then
  node scripts/check-deploy-debt.mjs
fi
